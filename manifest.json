{
  "manifest_version": 3,
  "name": "PDF Page Editor",
  "version": "1.3.0",
  "description": "PDFのページ並べ替え・削除・回転・結合・圧縮をブラウザ内だけで行う無料ツール",
  "action": {
    "default_title": "PDFを編集",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
